# RNF-03: el front de la bodega se sirve por HTTPS (443). El puerto HTTP solo redirige.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    # Certificado de esta bodega firmado por la CA del proyecto (lo escribe el user_data en secrets/tls)
    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:5m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # El front pregunta aquí de qué bodega es. Nginx reemplaza ${WAREHOUSE_ID} al arrancar
    # con la variable de entorno del contenedor (si no existe, el front la saca de la API).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.APP_CONFIG = { warehouseId: "${WAREHOUSE_ID}" };';
    }

    location /api/ {
        # Se reemplaza dinámicamente por Nginx usando la variable de entorno
        proxy_pass http://${API_TARGET}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # El login y el catálogo los atiende la central. Se va por HTTPS a su puerta de entrada (443)
    # y se REVISA su certificado con la CA del proyecto: si alguien se hace pasar por la central, no conecta.
    # Se revisa por el nombre interno (central.proyecto-iot.internal), que va en el certificado.
    location /identity/ {
        proxy_pass https://${CENTRAL_HOST}/svc/identity/;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/ca.crt;
        proxy_ssl_name central.proyecto-iot.internal;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
    }

    # Catálogo global de la central. Desde aquí el Administrador por Bodega ve el catálogo
    # y elige qué productos maneja su bodega.
    location /catalog/ {
        proxy_pass https://${CENTRAL_HOST}/svc/catalog/;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/ca.crt;
        proxy_ssl_name central.proyecto-iot.internal;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
    }
}
