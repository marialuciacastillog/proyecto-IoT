server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # El front pregunta aquí de qué bodega es. Nginx reemplaza ${WAREHOUSE_ID} al arrancar
    # con la variable de entorno del contenedor (si no existe, el front la saca de la API).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 'window.APP_CONFIG = { warehouseId: "${WAREHOUSE_ID}" };';
    }

    location /api/ {
        # Se reemplaza dinámicamente por Nginx usando la variable de entorno
        proxy_pass http://${API_TARGET}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Etapa A: el login lo hace el servicio de identidad de la central (IP elástica, puerto 8008).
    # Se pasa por aquí para que el navegador hable con un solo sitio (el front de la bodega).
    location /identity/ {
        proxy_pass http://${IDENTITY_TARGET}/;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
    }
}
