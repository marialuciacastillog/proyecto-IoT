#!/bin/bash
# Este script corre solo una vez, cuando la máquina prende por primera vez.
# Todo lo que pasa queda guardado en /var/log/proyecto-setup.log
exec > /var/log/proyecto-setup.log 2>&1
set -x

# 1. Instalar Docker y Git
apt-get update -y
apt-get install -y docker.io docker-compose-v2 git
systemctl enable --now docker

# 2. Perfil lab1: aquí usa el rol de la máquina (LabInstanceProfile), no credenciales copiadas
export HOME=/root
mkdir -p /root/.aws
cat > /root/.aws/config <<'CONFIG'
[profile lab1]
credential_source = Ec2InstanceMetadata
region = us-east-1
CONFIG

# 3. Bajar el proyecto
git clone ${repo_url} /opt/proyecto
export SYNC_QUEUE_URL="${sync_queue_url}"
export SYNC_TOPIC_ARN="${sync_topic_arn}"

# 4. Levantar lo que le toca a esta máquina
%{ if role == "central" ~}
# 4.1 Primero la central (base de datos + worker): crea la red y el volumen
cd /opt/proyecto/src/central_sync_worker
docker compose up -d --build

# 4.1b Fase 3: worker de auditoría (lee audit-queue, que recibe copia de cada evento por SNS)
export AUDIT_QUEUE_URL="${audit_queue_url}"
cd /opt/proyecto/src/central_audit_worker
docker compose up -d --build

# 4.2 Después los reportes, que usan la red de la central
export REPORTS_QUEUE_URL="${reports_queue_url}"
export REPORTS_BUCKET_NAME="${reports_bucket_name}"
cd /opt/proyecto/reports
docker compose up -d --build

# 4.3 Fase 6: transferencias entre bodegas (API en el puerto 8010 + orquestador)
cd /opt/proyecto/src/central_transfers
docker compose up -d --build

# 4.4 Fase 12: IoT en la central (ingesta en el puerto 8005 + workers storage, alerts y analytics)
cd /opt/proyecto/src/iot/central
docker compose up -d --build

# 4.5 Fase 8: proceso Batch. Se deja construido y programado con cron
# todos los días a las 23:00 (hora del servidor, que está en UTC)
cd /opt/proyecto/src/central_batch
echo "REPORTS_BUCKET_NAME=${reports_bucket_name}" > .env
docker compose build
cat > /etc/cron.d/proyecto-batch <<'CRON'
HOME=/root
0 23 * * * root cd /opt/proyecto/src/central_batch && docker compose run --rm batch >> /var/log/proyecto-batch.log 2>&1
CRON
%{ else ~}
cd /opt/proyecto/src/warehouse
docker compose -f docker/components/${wh_folder}/compose-warehouse.yml --project-directory . --env-file docker/components/${wh_folder}/.env up -d --build

# Fase 12: borde IoT (broker MQTT + sensores simulados + gateway).
# La máquina de wh-003 simula también WH-004 y WH-005: en total 5 bodegas y 100 sensores.
export IOT_WAREHOUSES="${role == "wh-003" ? "WH-003,WH-004,WH-005" : upper(role)}"
cd /opt/proyecto/src/iot/edge
docker compose up -d --build
%{ endif ~}

echo "LISTO: ${role}"
