{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicarSusMovimientos",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:us-east-1:*:inventory-events"
      ]
    },
    {
      "Sid": "LeerSoloSusColas",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:*:catalog-wh-001",
        "arn:aws:sqs:us-east-1:*:transfer-commands-wh-001"
      ]
    },
    {
      "Sid": "ResponderALaSaga",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:*:transfer-events"
      ]
    },
    {
      "Sid": "GatewayIoTBuscaLaCentral",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
